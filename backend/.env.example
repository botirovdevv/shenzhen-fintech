PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://femate:femate@localhost:5433/femate
CORS_ORIGIN=*                # comma-separated list, or * in dev
SEED_DEMO=true               # create the demo user (aziz@femate.uz / demo1234) on start if missing

LLM_PROVIDER=mock            # mock | openai
OPENAI_API_KEY=              # needed when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=                # voice to text (pass 2); empty = /transactions/voice answers 503 STT_UNAVAILABLE
TELEGRAM_BOT_TOKEN=          # @femate_uz_bot from @BotFather; empty = bot off (the daily push still runs)
LITHIC_API_KEY=              # FeMate virtual card (Lithic dashboard -> API keys); empty = card off
LITHIC_ENV=sandbox           # sandbox | production
LITHIC_ASA_SECRET=           # printed by `pnpm lithic:setup <url>`; required in production
# Only on the VM: TUNNEL_TOKEN for the Cloudflare tunnel "femate" (femate-api.usm0n.uz -> http://api:3000)
