TELEGRAM_BOT_TOKEN=          # @femate_uz_bot from @BotFather; empty = bot off (the daily push still runs)
# Only on the VM: TUNNEL_TOKEN for the Cloudflare tunnel "femate" (femate-api.usm0n.uz -> http://api:3000)
