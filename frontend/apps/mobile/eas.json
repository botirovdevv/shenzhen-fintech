{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.13.1",
      "pnpm": "12.11.2",
      "env": { "EXPO_PUBLIC_API_URL": "https://femate-api.usm0n.uz/api/v1" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "extends": "base",
      "android": { "buildType": "apk" },
      "ios": { "autoIncrement": true }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
